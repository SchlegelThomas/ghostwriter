# Copy to apps/backend/.env.e2e.local (gitignored) and fill in keys locally.
# Never commit real keys. Never paste keys into chat.

GHOSTWRITER_E2E=1
GHOSTWRITER_E2E_LIVE_OPENAI=1
PORT=8787
E2E_APP_ORIGIN=http://localhost:8081

# Optional BYOK seeds for the hermetic E2E writer account
GHOSTWRITER_E2E_SEED_OPENAI_KEY=
GHOSTWRITER_E2E_SEED_ANTHROPIC_KEY=
GHOSTWRITER_E2E_SEED_GOOGLE_KEY=
