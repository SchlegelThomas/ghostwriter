# Copy to apps/backend/.env.fly.local (gitignored) and fill secret values.
# Then run: ./scripts/setup-fly-backend-secrets.sh --generate-kek --sync-public-media
# Never commit real keys. Never paste keys into chat.
#
# Non-secret Ghostwriter production defaults are applied automatically by the
# setup script when unset (account id from `wrangler login`, bucket/domain names below).

# --- Already on Fly from prior deploys (optional to re-set) ---
# DATABRICKS_CLIENT_SECRET=
# BETTER_AUTH_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# --- Provider encryption (required for demo BYOK / Settings keys) ---
# Generate with script flag --generate-kek, or: openssl rand -base64 32
GHOSTWRITER_PROVIDER_KEK_V1=
GHOSTWRITER_PROVIDER_KEK_ACTIVE=V1

# --- Demo account BYOK (falls back to GHOSTWRITER_E2E_SEED_* in .env.e2e.local) ---
GHOSTWRITER_DEMO_SEED_OPENAI_KEY=
GHOSTWRITER_DEMO_SEED_ANTHROPIC_KEY=
GHOSTWRITER_DEMO_SEED_GOOGLE_KEY=

# --- Private R2 (Capture + covers). Access keys: Cloudflare → R2 → API Tokens ---
# Create once at: https://dash.cloudflare.com/<account>/r2/api-tokens
# (Wrangler OAuth cannot mint these S3 credentials for Fly.)
R2_ACCOUNT_ID=dd0edd263f71cb4108826464f45e0045
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=ghostwriter-capture

# --- Public character media (set together with private R2) ---
GHOSTWRITER_PUBLIC_MEDIA_ORIGIN=https://media.ghost-writer.studio
GHOSTWRITER_PUBLIC_R2_BUCKET_NAME=ghostwriter-public-media

# --- Optional Reader TTS ---
ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_DEFAULT=
# ELEVENLABS_VOICE_NARRATIVE=
# ELEVENLABS_VOICE_NOIR=
# ELEVENLABS_VOICE_SOFT=
